<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:BrewLog.UI.Controls">

    <!--
      CleanDataGrid — таблиця-картка: без сітки, рядок 44, рядки із заокругленим виділенням.
      CleanDataGrid.Flat — та сама таблиця без власної картки, для розміщення всередині Card.
      CleanDataGrid.Form — таблиця-форма всередині прокручуваного списку: поля в DataGridTemplateColumn видимі завжди, без режиму редагування клітинки.
      Числові колонки форми: HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}".

      Ширину колонок задавайте явно: Width="*" для тексту, Width="{StaticResource Column.Number}" для чисел.
      Числові колонки вирівнюйте праворуч: HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}",
      ElementStyle="{StaticResource CleanDataGrid.Number}". Довгий текст обрізайте: ElementStyle="{StaticResource CleanDataGrid.Text}".
      Числовій колонці поруч із зірочковими задавайте і MinWidth (Column.MinNarrow, Column.MinNumber): без нього у вузькому вікні DataGrid
      стискає її й обрізає числа («1,0…»), а з ним показує горизонтальну прокрутку.
      Колонка Auto поруч із колонкою * обрізає значення, значно ширші за заголовок: DataGrid не віддає їй місце.
    -->

    <sys:Double x:Key="Column.MinText">120</sys:Double>
    <DataGridLength x:Key="Column.Narrow">72</DataGridLength>
    <sys:Double x:Key="Column.MinNarrow">72</sys:Double>
    <DataGridLength x:Key="Column.Number">96</DataGridLength>
    <sys:Double x:Key="Column.MinNumber">96</sys:Double>
    <DataGridLength x:Key="Column.Medium">160</DataGridLength>
    <sys:Double x:Key="Column.MinName">100</sys:Double>
    <DataGridLength x:Key="Column.Input">80</DataGridLength>
    <DataGridLength x:Key="Column.Wide">140</DataGridLength>
    <DataGridLength x:Key="Column.Contribution">150</DataGridLength>
    <DataGridLength x:Key="Column.Icon">44</DataGridLength>
    <DataGridLength x:Key="Column.Person">200</DataGridLength>
    <sys:Double x:Key="Column.MinWide">180</sys:Double>
    <DataGridLength x:Key="Column.Attention">250</DataGridLength>
    <DataGridLength x:Key="Column.Date">112</DataGridLength>
    <DataGridLength x:Key="Column.Status">172</DataGridLength>
    <sys:Double x:Key="Row.TwoLines">64</sys:Double>

    <Style x:Key="CleanDataGrid.Gripper" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CleanDataGrid.ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <!-- На 2 більше, ніж у клітинки: текст клітинки має власний відступ 2, і так колонки збігаються. -->
        <Setter Property="Padding" Value="18,0,16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid Background="{TemplateBinding Background}">
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="SortGlyph"
                                       DockPanel.Dock="Right"
                                       Style="{StaticResource Icon}"
                                       FontSize="{StaticResource FontSize.Tiny}"
                                       Margin="{StaticResource Gap.Left.8}"
                                       Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                        <Thumb x:Name="PART_LeftHeaderGripper"
                               HorizontalAlignment="Left"
                               Style="{StaticResource CleanDataGrid.Gripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper"
                               HorizontalAlignment="Right"
                               Style="{StaticResource CleanDataGrid.Gripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortGlyph" Property="Text" Value="{StaticResource Glyph.ChevronUp}" />
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortGlyph" Property="Text" Value="{StaticResource Glyph.ChevronDown}" />
                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CleanDataGrid.NumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CleanDataGrid.ColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!-- Текст клітинок: обрізання з трикрапкою й числа праворуч -->
    <Style x:Key="CleanDataGrid.Text" TargetType="TextBlock">
        <Setter Property="Padding" Value="2,0,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CleanDataGrid.Number" TargetType="TextBlock" BasedOn="{StaticResource CleanDataGrid.Text}">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Другорядний дрібний текст, наприклад внесок рядка в редакторі. -->
    <Style x:Key="CleanDataGrid.Caption" TargetType="TextBlock" BasedOn="{StaticResource CleanDataGrid.Text}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    </Style>

    <Style x:Key="CleanDataGrid.Row" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Item}"
                            SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </SelectiveScrollingGrid.RowDefinitions>
                            <DataGridCellsPresenter Grid.Column="1"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <DataGridDetailsPresenter Grid.Row="1"
                                                      Grid.Column="1"
                                                      SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      Visibility="{TemplateBinding DetailsVisibility}" />
                            <DataGridRowHeader Grid.RowSpan="2"
                                               SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                               Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </SelectiveScrollingGrid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Рядок, який потребує уваги: контекст даних має NeedsAttention. Наведення й вибір оголошені повторно, щоб підсвітка їх не перекривала. -->
    <Style x:Key="CleanDataGrid.AttentionRow" TargetType="DataGridRow" BasedOn="{StaticResource CleanDataGrid.Row}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                <Setter Property="Background" Value="{StaticResource Warning.Soft}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CleanDataGrid.Cell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CleanDataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="44" />
        <Setter Property="ColumnHeaderHeight" Value="40" />
        <!-- Типове значення SizeToHeader рахує ширину лише за заголовком, навіть коли зірочкових колонок немає. -->
        <Setter Property="ColumnWidth" Value="Auto" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CleanDataGrid.ColumnHeader}" />
        <Setter Property="RowStyle" Value="{StaticResource CleanDataGrid.Row}" />
        <Setter Property="CellStyle" Value="{StaticResource CleanDataGrid.Cell}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Card}"
                                Effect="{StaticResource Shadow.Card}" />
                        <ScrollViewer x:Name="DG_ScrollViewer" Margin="{TemplateBinding Padding}" Focusable="False">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                                        Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                Grid.Row="1"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Maximum="{TemplateBinding ScrollableHeight}"
                                                   Orientation="Vertical"
                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding NonFrozenColumnsViewportHorizontalOffset, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                                       Grid.Column="1"
                                                       Maximum="{TemplateBinding ScrollableWidth}"
                                                       Orientation="Horizontal"
                                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </Grid>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CleanDataGrid.Flat" TargetType="DataGrid" BasedOn="{StaticResource CleanDataGrid}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Заголовки форми вирівняні за її щільнішими клітинками: текст починається там само, де назва, а над полем стоїть над числом. -->
    <Style x:Key="CleanDataGrid.FormHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CleanDataGrid.ColumnHeader}">
        <Setter Property="Padding" Value="6,0,4,0" />
    </Style>

    <Style x:Key="CleanDataGrid.FormNumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CleanDataGrid.FormHeader}">
        <Setter Property="Padding" Value="4,0,16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!-- Клітинка не бере фокус сама: інакше Tab зупинявся б на кожному полі двічі. -->
    <Style x:Key="CleanDataGrid.FormCell" TargetType="DataGridCell" BasedOn="{StaticResource CleanDataGrid.Cell}">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!-- IsReadOnly стосується лише режиму редагування клітинки: поля з шаблонів колонок лишаються редагованими. -->
    <Style x:Key="CleanDataGrid.Form" TargetType="DataGrid" BasedOn="{StaticResource CleanDataGrid.Flat}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CleanDataGrid.FormHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource CleanDataGrid.FormCell}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
        <Setter Property="controls:WheelForwarding.IsEnabled" Value="True" />
    </Style>

</ResourceDictionary>
