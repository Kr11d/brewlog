<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палітра «Темне пиво» (HANDOFF §9.2). Для кожного ключа: <ключ>.Color — колір, <ключ> — пензель. -->

    <Color x:Key="Bg.GradientStart.Color">#FBF7F1</Color>
    <Color x:Key="Bg.GradientEnd.Color">#EFE3D3</Color>
    <Color x:Key="Surface.Color">#FFFFFF</Color>
    <Color x:Key="Surface.Muted.Color">#F5EEE4</Color>
    <Color x:Key="Border.Color">#E7DCCD</Color>
    <Color x:Key="Text.Primary.Color">#23150F</Color>
    <Color x:Key="Text.Secondary.Color">#7A665A</Color>
    <Color x:Key="Accent.Color">#5E1A28</Color>
    <Color x:Key="Accent.Hover.Color">#4A1420</Color>
    <Color x:Key="Accent.Soft.Color">#F2E2E2</Color>
    <Color x:Key="Amber.Color">#B9772B</Color>
    <Color x:Key="Success.Color">#2F7D57</Color>
    <Color x:Key="Warning.Color">#B7791F</Color>
    <Color x:Key="Danger.Color">#B42318</Color>
    <Color x:Key="Info.Color">#3B5B8C</Color>
    <Color x:Key="Stage.Planned.Color">#8C7B70</Color>
    <Color x:Key="Stage.Brewing.Color">#B9772B</Color>
    <Color x:Key="Stage.Fermenting.Color">#3B5B8C</Color>
    <Color x:Key="Stage.Conditioning.Color">#6A4C93</Color>
    <Color x:Key="Stage.Packaged.Color">#2F7D57</Color>
    <Color x:Key="DocCard.GradientStart.Color">#B9772B</Color>
    <Color x:Key="DocCard.GradientEnd.Color">#5E1A28</Color>

    <!-- Кольори станів елементів: у палітрі §9.2 їх немає, але без них не намалювати натискання, вимкнення й тінь. -->
    <Color x:Key="Accent.Pressed.Color">#3A0F19</Color>
    <Color x:Key="Text.Disabled.Color">#B5A79B</Color>
    <Color x:Key="Text.OnAccent.Color">#FFFFFF</Color>
    <Color x:Key="Shadow.Color">#3B2314</Color>

    <SolidColorBrush x:Key="Bg.GradientStart" Color="{StaticResource Bg.GradientStart.Color}" />
    <SolidColorBrush x:Key="Bg.GradientEnd" Color="{StaticResource Bg.GradientEnd.Color}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource Surface.Color}" />
    <SolidColorBrush x:Key="Surface.Muted" Color="{StaticResource Surface.Muted.Color}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource Border.Color}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.Primary.Color}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource Accent.Color}" />
    <SolidColorBrush x:Key="Accent.Hover" Color="{StaticResource Accent.Hover.Color}" />
    <SolidColorBrush x:Key="Accent.Soft" Color="{StaticResource Accent.Soft.Color}" />
    <SolidColorBrush x:Key="Amber" Color="{StaticResource Amber.Color}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource Success.Color}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource Warning.Color}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger.Color}" />
    <SolidColorBrush x:Key="Info" Color="{StaticResource Info.Color}" />
    <SolidColorBrush x:Key="Stage.Planned" Color="{StaticResource Stage.Planned.Color}" />
    <SolidColorBrush x:Key="Stage.Brewing" Color="{StaticResource Stage.Brewing.Color}" />
    <SolidColorBrush x:Key="Stage.Fermenting" Color="{StaticResource Stage.Fermenting.Color}" />
    <SolidColorBrush x:Key="Stage.Conditioning" Color="{StaticResource Stage.Conditioning.Color}" />
    <SolidColorBrush x:Key="Stage.Packaged" Color="{StaticResource Stage.Packaged.Color}" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="{StaticResource Accent.Pressed.Color}" />
    <SolidColorBrush x:Key="Text.Disabled" Color="{StaticResource Text.Disabled.Color}" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="{StaticResource Text.OnAccent.Color}" />
    <SolidColorBrush x:Key="Text.OnAccent.Muted" Color="{StaticResource Text.OnAccent.Color}" Opacity="0.78" />

    <!-- М'які тоновані фони чипів: той самий колір із прозорістю, тож палітра не розростається. -->
    <SolidColorBrush x:Key="Success.Soft" Color="{StaticResource Success.Color}" Opacity="0.12" />
    <SolidColorBrush x:Key="Warning.Soft" Color="{StaticResource Warning.Color}" Opacity="0.14" />
    <SolidColorBrush x:Key="Danger.Soft" Color="{StaticResource Danger.Color}" Opacity="0.11" />
    <SolidColorBrush x:Key="Info.Soft" Color="{StaticResource Info.Color}" Opacity="0.12" />
    <SolidColorBrush x:Key="Stage.Planned.Soft" Color="{StaticResource Stage.Planned.Color}" Opacity="0.14" />
    <SolidColorBrush x:Key="Stage.Brewing.Soft" Color="{StaticResource Stage.Brewing.Color}" Opacity="0.14" />
    <SolidColorBrush x:Key="Stage.Fermenting.Soft" Color="{StaticResource Stage.Fermenting.Color}" Opacity="0.12" />
    <SolidColorBrush x:Key="Stage.Conditioning.Soft" Color="{StaticResource Stage.Conditioning.Color}" Opacity="0.12" />
    <SolidColorBrush x:Key="Stage.Packaged.Soft" Color="{StaticResource Stage.Packaged.Color}" Opacity="0.12" />

    <SolidColorBrush x:Key="Scroll.Thumb" Color="{StaticResource Text.Secondary.Color}" Opacity="0.35" />
    <SolidColorBrush x:Key="Scroll.Thumb.Hover" Color="{StaticResource Text.Secondary.Color}" Opacity="0.6" />

    <LinearGradientBrush x:Key="Bg.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource Bg.GradientStart.Color}" />
        <GradientStop Offset="1" Color="{StaticResource Bg.GradientEnd.Color}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DocCard.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource DocCard.GradientStart.Color}" />
        <GradientStop Offset="1" Color="{StaticResource DocCard.GradientEnd.Color}" />
    </LinearGradientBrush>

</ResourceDictionary>
