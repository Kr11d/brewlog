<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:BrewLog.UI.Controls"
                    xmlns:converters="clr-namespace:BrewLog.UI.Converters">

    <!--
      Як користуватися темою.
      Стилі, які підключаються явно:
        ContentControl: Card, DocCard, Chip (+ .Accent .Row .Planned .Brewing .Fermenting .Conditioning .Packaged .Success .Warning .Danger .Info),
                        IconBadge, IconBadge.Large, Avatar, Avatar.Row, Avatar.Small, StepBadge, LogoMark, LogoMark.Large
        Button:         PrimaryButton, SecondaryButton, SecondaryButton.Compact, TextButton, IconButton, IconButton.Cell, ListRowCard, ListRowCard.Selectable, BoardCard, MenuButton, PickerOption
        TextBox:        InputBox, InputArea (плейсхолдер у Tag); SearchBox (поле пошуку екрана: Ctrl+F переводить у нього фокус);
                        NumberBox, NumberBox.Cell (DataContext — NumberField: текст прив'язаний сам, неправильне число дає червону рамку)
        PasswordBox:    InputPassword (плейсхолдер у Tag)
        ComboBox:       InputCombo, InputCombo.Cell (плейсхолдер у Tag)
        CheckBox:       ToggleSwitch (перемикач «увімкнено / вимкнено»)
        RadioButton:    SegmentedButton усередині Border зі стилем SegmentedGroup
        Border:         Divider, BoardColumn (колонка дошки партій), StepLine (лінія шкали етапів)
        Ellipse:        Swatch, Swatch.Large (кольорова плашка пива; Fill через SrmToBrush), StageDot (крапка етапу; Fill через ResourceByKey)
        StyleRangeBar:  StyleRangeBar (контекст даних має IsWithin)
        Window:         BrewWindow, LoginWindow, DialogWindow (Esc закриває), EditorWindow, MessageWindow
      Застосовуються самі: CheckBox, RadioButton, DatePicker (плейсхолдер у Tag), ScrollBar, ToolTip, TabControl, TabItem.
      Таблиця — CleanDataGrid у DataGrid.xaml; стилі тексту — у Typography.xaml.
    -->

    <converters:InitialsConverter x:Key="Initials" />
    <converters:SrmToBrushConverter x:Key="SrmToBrush" />
    <converters:ResourceByKeyConverter x:Key="ResourceByKey" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Розміри -->
    <sys:Double x:Key="Size.Control">48</sys:Double>
    <sys:Double x:Key="Size.ControlSmall">40</sys:Double>
    <GridLength x:Key="Width.Menu">260</GridLength>
    <sys:Double x:Key="Width.LoginCard">420</sys:Double>
    <GridLength x:Key="Width.ListPane">380</GridLength>
    <GridLength x:Key="Width.PreviewPane">360</GridLength>
    <GridLength x:Key="Width.Filter">300</GridLength>
    <GridLength x:Key="Width.EditorParams">260</GridLength>
    <GridLength x:Key="Width.EditorStats">300</GridLength>
    <GridLength x:Key="Width.StyleCode">120</GridLength>
    <GridLength x:Key="Width.RangeLabel">72</GridLength>
    <sys:Double x:Key="Width.Picker">320</sys:Double>
    <sys:Double x:Key="Width.BoardColumn">244</sys:Double>
    <sys:Double x:Key="Size.StageDot">10</sys:Double>
    <sys:Double x:Key="Size.AvatarSmall">28</sys:Double>
    <sys:Double x:Key="Size.Step">32</sys:Double>
    <sys:Double x:Key="Height.Chart">240</sys:Double>
    <sys:Double x:Key="Height.MeasurementsTable">280</sys:Double>
    <GridLength x:Key="Width.CardSide">480</GridLength>
    <sys:Double x:Key="Height.PickerList">260</sys:Double>
    <sys:Double x:Key="Size.ControlCell">36</sys:Double>
    <sys:Double x:Key="Size.RangeBar">12</sys:Double>
    <sys:Double x:Key="Opacity.Muted">0.55</sys:Double>
    <sys:Double x:Key="Size.LogoLarge">64</sys:Double>

    <CornerRadius x:Key="Radius.Card">24</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">24</CornerRadius>
    <CornerRadius x:Key="Radius.PillSmall">20</CornerRadius>
    <CornerRadius x:Key="Radius.Popup">16</CornerRadius>
    <CornerRadius x:Key="Radius.Row">16</CornerRadius>
    <CornerRadius x:Key="Radius.Input">14</CornerRadius>
    <CornerRadius x:Key="Radius.Item">10</CornerRadius>

    <!-- Відступи: за шкалою 8/16/24/32 -->
    <Thickness x:Key="Pad.Shell">16</Thickness>
    <Thickness x:Key="Pad.Content">32,16,16,16</Thickness>
    <Thickness x:Key="Pad.Card">24</Thickness>
    <Thickness x:Key="Pad.CardLarge">32</Thickness>
    <Thickness x:Key="Pad.Dialog">32,24,32,32</Thickness>
    <Thickness x:Key="Pad.Menu">16</Thickness>
    <Thickness x:Key="Pad.DialogShadow">24</Thickness>
    <Thickness x:Key="Pad.Button">28,0</Thickness>
    <Thickness x:Key="Pad.ButtonSmall">16,0</Thickness>
    <Thickness x:Key="Pad.ButtonCompact">8,0</Thickness>
    <Thickness x:Key="Pad.Input">14,0</Thickness>
    <Thickness x:Key="Pad.InputCell">8,0</Thickness>
    <Thickness x:Key="Pad.Picker">12</Thickness>
    <Thickness x:Key="Pad.PickerOption">12,8</Thickness>
    <Thickness x:Key="Pad.PopupShadow">16,4,16,28</Thickness>
    <Thickness x:Key="Stroke.Input">2</Thickness>

    <Thickness x:Key="Gap.Top.4">0,4,0,0</Thickness>
    <Thickness x:Key="Gap.Top.8">0,8,0,0</Thickness>
    <Thickness x:Key="Gap.Top.16">0,16,0,0</Thickness>
    <Thickness x:Key="Gap.Top.24">0,24,0,0</Thickness>
    <Thickness x:Key="Gap.Top.32">0,32,0,0</Thickness>
    <Thickness x:Key="Gap.Bottom.4">0,0,0,4</Thickness>
    <Thickness x:Key="Gap.Bottom.8">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Bottom.16">0,0,0,16</Thickness>
    <Thickness x:Key="Gap.Bottom.24">0,0,0,24</Thickness>
    <Thickness x:Key="Gap.Left.4">4,0,0,0</Thickness>
    <Thickness x:Key="Gap.Left.8">8,0,0,0</Thickness>
    <Thickness x:Key="Gap.Left.12">12,0,0,0</Thickness>
    <Thickness x:Key="Gap.Left.16">16,0,0,0</Thickness>
    <Thickness x:Key="Gap.Left.24">24,0,0,0</Thickness>
    <Thickness x:Key="Gap.Right.4">0,0,4,0</Thickness>
    <Thickness x:Key="Gap.Right.8">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.Sides.4">4,0,4,0</Thickness>

    <!-- Тіні -->
    <DropShadowEffect x:Key="Shadow.Card" BlurRadius="36" ShadowDepth="8" Direction="270" Opacity="0.07" Color="{StaticResource Shadow.Color}" />
    <DropShadowEffect x:Key="Shadow.Popup" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.18" Color="{StaticResource Shadow.Color}" />

    <!-- Логотип: контур келиха з піною -->
    <Geometry x:Key="Geometry.Mug">M5,8 H15 V19 A2,2 0 0 1 13,21 H7 A2,2 0 0 1 5,19 Z M15,11 H17 A2,2 0 0 1 19,13 V15 A2,2 0 0 1 17,17 H15 M5,8 C4,5.5 6.5,3.8 8,5 C9,3 12,3 13,5 C14.5,4 16,6 15,8 M8.5,12 V17 M11.5,12 V17</Geometry>

    <!-- Фокус із клавіатури: WPF показує ці рамки лише після Tab, а не після кліку мишею -->
    <Style x:Key="FocusRing.Pill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="28" BorderThickness="2" BorderBrush="{StaticResource Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusRing.Circle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Margin="-2" StrokeThickness="2" Stroke="{StaticResource Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusRing.Box">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вікна -->
    <Style x:Key="BrewWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Bg.Gradient}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Width" Value="1280" />
        <Setter Property="Height" Value="800" />
        <Setter Property="MinWidth" Value="1200" />
        <Setter Property="MinHeight" Value="760" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="controls:WindowCaption.Background" Value="{StaticResource Bg.GradientStart.Color}" />
        <Setter Property="controls:WindowCaption.Foreground" Value="{StaticResource Text.Primary.Color}" />
    </Style>

    <!-- Вікно входу: компактне, без зміни розміру; картка входу стоїть по центру градієнта. -->
    <Style x:Key="LoginWindow" TargetType="Window" BasedOn="{StaticResource BrewWindow}">
        <Setter Property="Width" Value="560" />
        <Setter Property="Height" Value="760" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="ResizeMode" Value="CanMinimize" />
    </Style>

    <!-- Модальний діалог із системним заголовком, наприклад «Користувачі» чи «Довідники». -->
    <Style x:Key="DialogWindow" TargetType="Window" BasedOn="{StaticResource BrewWindow}">
        <Setter Property="Width" Value="1040" />
        <Setter Property="Height" Value="720" />
        <Setter Property="MinWidth" Value="880" />
        <Setter Property="MinHeight" Value="600" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="controls:CloseOnEscape.IsEnabled" Value="True" />
    </Style>

    <!-- Велике модальне вікно на кілька колонок, наприклад редактор рецепта. Колонки прокручуються окремо, тому мінімальна висота менша. -->
    <Style x:Key="EditorWindow" TargetType="Window" BasedOn="{StaticResource BrewWindow}">
        <Setter Property="WindowState" Value="Maximized" />
        <Setter Property="MinHeight" Value="600" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <!-- Вікно-картка без заголовка; прозорий край лишає місце для тіні. -->
    <Style x:Key="MessageWindow" TargetType="Window" BasedOn="{StaticResource BrewWindow}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="480" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <!-- Картки. Тінь на окремому шарі: ефект на самому вмісті зробив би текст розмитим. -->
    <Style x:Key="Card" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Card}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Card}"
                                Effect="{StaticResource Shadow.Card}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DocCard" TargetType="ContentControl" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource DocCard.Gradient}" />
        <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}" />
    </Style>

    <!-- Кольорова плашка пива -->
    <Style x:Key="Swatch" TargetType="Ellipse">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stroke" Value="{StaticResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Swatch.Large" TargetType="Ellipse" BasedOn="{StaticResource Swatch}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Stroke" Value="{StaticResource Text.OnAccent.Muted}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <!-- Крапка кольору етапу в заголовку колонки дошки. -->
    <Style x:Key="StageDot" TargetType="Ellipse">
        <Setter Property="Width" Value="{StaticResource Size.StageDot}" />
        <Setter Property="Height" Value="{StaticResource Size.StageDot}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Колонка дошки партій: напівпрозора заокруглена панель. -->
    <Style x:Key="BoardColumn" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Width.BoardColumn}" />
        <Setter Property="Background" Value="{StaticResource Board.Column}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="{StaticResource Gap.Right.8}" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Border}" />
    </Style>

    <!-- Кнопки-«пігулки» -->
    <ControlTemplate x:Key="Template.PillButton" TargetType="Button">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Pill}"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource Template.PillButton}" />
        <Setter Property="Height" Value="{StaticResource Size.Control}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Button}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Pill}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Border}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Вужча другорядна кнопка: для кількох дій поряд у вузькій панелі. -->
    <Style x:Key="SecondaryButton.Compact" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="{StaticResource Pad.ButtonCompact}" />
    </Style>

    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Height" Value="{StaticResource Size.ControlSmall}" />
        <Setter Property="Padding" Value="{StaticResource Pad.ButtonSmall}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Кругла кнопка з гліфом: гліф передається через Content -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Size.ControlSmall}" />
        <Setter Property="Height" Value="{StaticResource Size.ControlSmall}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Icon}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Circle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Border}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Менша кругла кнопка для рядка таблиці -->
    <Style x:Key="IconButton.Cell" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="{StaticResource Size.ControlCell}" />
        <Setter Property="Height" Value="{StaticResource Size.ControlCell}" />
    </Style>

    <!-- Пункт списку у спливному виборі: виглядає як пункт InputCombo, але є звичайною кнопкою -->
    <Style x:Key="PickerOption" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Padding" Value="{StaticResource Pad.PickerOption}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Item}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Пункт бічного меню. Контекст даних має властивість IsActive. -->
    <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Padding" Value="{StaticResource Pad.ButtonSmall}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Рядок-картка зі стрілкою праворуч -->
    <Style x:Key="ListRowCard" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="{StaticResource Gap.Bottom.8}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Box}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Row}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Style="{StaticResource Icon}"
                                       FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="{StaticResource Gap.Left.12}"
                                       Text="{StaticResource Glyph.ChevronRight}" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Border}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      Рядок-картка списку з вибором. Контекст даних має властивості IsSelected (виділити)
      та IsMuted (приглушити, наприклад вимкнений обліковий запис).
    -->
    <Style x:Key="ListRowCard.Selectable" TargetType="Button" BasedOn="{StaticResource ListRowCard}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Muted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Картка партії на дошці: уся картка клікабельна, а кнопка всередині неї перехоплює власний клік. -->
    <Style x:Key="BoardCard" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="{StaticResource Gap.Bottom.8}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Box}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Row}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Поля вводу -->
    <Style x:Key="InputBase" TargetType="Control">
        <Setter Property="Height" Value="{StaticResource Size.Control}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Input}" />
        <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.Input}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Background" Value="{StaticResource Surface}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource InputBase}">
        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Input}">
                        <!-- Padding текстового поля WPF передає в PART_ContentHost сам; плейсхолдеру його треба задати явно. -->
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                            <TextBlock x:Name="Placeholder"
                                       Margin="{TemplateBinding Padding}"
                                       Padding="2,0,0,0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputArea" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Поле пошуку екрана: Ctrl+F переводить у нього фокус. -->
    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
        <Setter Property="controls:SearchShortcut.IsTarget" Value="True" />
    </Style>

    <!-- Числове поле: контекст даних — NumberField. Текст прив'язаний тут, щоб не повторювати це в кожному полі форми. -->
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
        <Setter Property="Text" Value="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsValid}" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Те саме поле для рядка таблиці: нижче й щільніше, число праворуч. -->
    <Style x:Key="NumberBox.Cell" TargetType="TextBox" BasedOn="{StaticResource NumberBox}">
        <Setter Property="Height" Value="{StaticResource Size.ControlCell}" />
        <Setter Property="Padding" Value="{StaticResource Pad.InputCell}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="InputPassword" TargetType="PasswordBox" BasedOn="{StaticResource InputBase}">
        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="controls:PasswordAssist.TrackEmpty" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Input}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                            <TextBlock x:Name="Placeholder"
                                       Margin="{TemplateBinding Padding}"
                                       Padding="2,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Text.Secondary}"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="controls:PasswordAssist.IsEmpty" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Випадний список -->
    <Style x:Key="InputCombo.Toggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <TextBlock x:Name="Chevron"
                                   Style="{StaticResource Icon}"
                                   FontSize="{StaticResource FontSize.Tiny}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,16,0"
                                   Text="{StaticResource Glyph.ChevronDown}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Text" Value="{StaticResource Glyph.ChevronUp}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputCombo.Item" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Item}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InputCombo.Editor" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputCombo" TargetType="ComboBox" BasedOn="{StaticResource InputBase}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource InputCombo.Item}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Box"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Input}" />
                        <ToggleButton Style="{StaticResource InputCombo.Toggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <ContentPresenter x:Name="Selection"
                                              Margin="4,0,28,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <TextBlock x:Name="Placeholder"
                                       Margin="4,0,28,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Text="{TemplateBinding Tag}"
                                       Visibility="Collapsed" />
                        </Grid>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{StaticResource InputCombo.Editor}"
                                 Margin="16,0,40,0"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Visibility="Hidden" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               HorizontalOffset="-16"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Grid Margin="16,4,16,28"
                                  MinWidth="{Binding ActualWidth, ElementName=Box}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="{StaticResource Surface}"
                                        CornerRadius="{StaticResource Radius.Popup}"
                                        Effect="{StaticResource Shadow.Popup}" />
                                <ScrollViewer Margin="6" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Surface}" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Те саме поле для рядка таблиці: нижче й щільніше. -->
    <Style x:Key="InputCombo.Cell" TargetType="ComboBox" BasedOn="{StaticResource InputCombo}">
        <Setter Property="Height" Value="{StaticResource Size.ControlCell}" />
        <Setter Property="Padding" Value="{StaticResource Pad.InputCell}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    </Style>

    <!-- Календар і поле дати -->
    <Style x:Key="InputDate.DayButton" TargetType="CalendarDayButton">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border Margin="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{StaticResource Stroke.Input}"
                            CornerRadius="{StaticResource Radius.Item}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
            </Trigger>
            <Trigger Property="IsToday" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}" />
            </Trigger>
            <Trigger Property="IsBlackedOut" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InputDate.PeriodButton" TargetType="CalendarButton">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="48" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border Margin="1"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Item}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
            </Trigger>
            <Trigger Property="HasSelectedDays" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InputDate.HeaderButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InputDate.NavButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    </Style>

    <Style x:Key="InputDate.CalendarItem" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Style="{StaticResource Caption}"
                                       Margin="0,4"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="{StaticResource Gap.Bottom.8}">
                            <Button x:Name="PART_PreviousButton"
                                    DockPanel.Dock="Left"
                                    Style="{StaticResource InputDate.NavButton}"
                                    Focusable="False"
                                    Content="{StaticResource Glyph.ChevronLeft}"
                                    ToolTip="Попередній" />
                            <Button x:Name="PART_NextButton"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource InputDate.NavButton}"
                                    Focusable="False"
                                    Content="{StaticResource Glyph.ChevronRight}"
                                    ToolTip="Наступний" />
                            <Button x:Name="PART_HeaderButton"
                                    Style="{StaticResource InputDate.HeaderButton}"
                                    Focusable="False"
                                    HorizontalAlignment="Center" />
                        </DockPanel>
                        <Grid x:Name="PART_MonthView" Grid.Row="1" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>
                        <Grid x:Name="PART_YearView" Grid.Row="1" HorizontalAlignment="Center" Visibility="Hidden">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputDate.Calendar" TargetType="Calendar">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource InputDate.CalendarItem}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource InputDate.DayButton}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource InputDate.PeriodButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Grid x:Name="PART_Root" Margin="16,4,16,28">
                        <Border Background="{StaticResource Surface}"
                                CornerRadius="{StaticResource Radius.Popup}"
                                Effect="{StaticResource Shadow.Popup}" />
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Margin="12"
                                      Style="{TemplateBinding CalendarItemStyle}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputDate.TextBox" TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputDate" TargetType="DatePicker" BasedOn="{StaticResource InputBase}">
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="CalendarStyle" Value="{StaticResource InputDate.Calendar}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Box"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Input}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Style="{StaticResource InputDate.TextBox}"
                                               Margin="{TemplateBinding Padding}" />
                            <TextBlock x:Name="Placeholder"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Text.Secondary}"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}"
                                       Visibility="Collapsed" />
                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    Margin="0,0,2,0"
                                    Focusable="False"
                                    Foreground="{StaticResource Text.Secondary}"
                                    Content="{StaticResource Glyph.Calendar}"
                                    ToolTip="Обрати дату" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   HorizontalOffset="-16"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Box}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedDate" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker" BasedOn="{StaticResource InputDate}" />

    <!-- Прапорець і перемикач -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Box}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Background="{StaticResource Surface.Muted}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="{StaticResource Stroke.Input}"
                                    CornerRadius="7" />
                            <Path x:Name="Mark"
                                  Data="M5.5,11.5 L9.5,15.5 L16.5,7.5"
                                  Stroke="{StaticResource Text.OnAccent}"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2.2"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Box}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring"
                                     Fill="{StaticResource Surface.Muted}"
                                     Stroke="{StaticResource Border}"
                                     StrokeThickness="2" />
                            <Ellipse x:Name="Dot"
                                     Width="10"
                                     Height="10"
                                     Fill="{StaticResource Text.OnAccent}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{StaticResource Accent}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Перемикач «увімкнено / вимкнено» на основі CheckBox -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Box}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Grid Width="44" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Track" Background="{StaticResource Border}" CornerRadius="12" />
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Margin="3,0"
                                     HorizontalAlignment="Left"
                                     Fill="{StaticResource Surface}" />
                        </Grid>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Text.Disabled}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent.Hover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Шкала відповідності стилю: у межах — Success, поза ними — Danger. Контекст даних має властивість IsWithin. -->
    <Style x:Key="StyleRangeBar" TargetType="controls:StyleRangeBar">
        <Setter Property="Height" Value="{StaticResource Size.RangeBar}" />
        <Setter Property="TrackBrush" Value="{StaticResource Success.Soft}" />
        <Setter Property="MarkerBrush" Value="{StaticResource Success}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWithin}" Value="False">
                <Setter Property="TrackBrush" Value="{StaticResource Danger.Soft}" />
                <Setter Property="MarkerBrush" Value="{StaticResource Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Сегменти: RadioButton-и всередині спільної підкладки, наприклад «Дошка / Список» -->
    <Style x:Key="SegmentedGroup" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SegmentedButton" TargetType="RadioButton">
        <Setter Property="Height" Value="{StaticResource Size.ControlSmall}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Pill}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.PillSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Чипи статусів -->
    <Style x:Key="Chip" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Input}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chip.Accent" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <!-- Для ListRowCard.Selectable: на тонованому фоні вибраного рядка чип не зливається з ним. Контекст даних має IsSelected. -->
    <Style x:Key="Chip.Row" TargetType="ContentControl" BasedOn="{StaticResource Chip.Accent}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Chip.Planned" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Stage.Planned.Soft}" />
        <Setter Property="Foreground" Value="{StaticResource Stage.Planned}" />
    </Style>
    <Style x:Key="Chip.Brewing" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Stage.Brewing.Soft}" />
        <Setter Property="Foreground" Value="{StaticResource Stage.Brewing}" />
    </Style>
    <Style x:Key="Chip.Fermenting" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Stage.Fermenting.Soft}" />
        <Setter Property="Foreground" Value="{StaticResource Stage.Fermenting}" />
    </Style>
    <Style x:Key="Chip.Conditioning" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Stage.Conditioning.Soft}" />
        <Setter Property="Foreground" Value="{StaticResource Stage.Conditioning}" />
    </Style>
    <Style x:Key="Chip.Packaged" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Stage.Packaged.Soft}" />
        <Setter Property="Foreground" Value="{StaticResource Stage.Packaged}" />
    </Style>
    <Style x:Key="Chip.Success" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Success.Soft}" />
        <Setter Property="Foreground" Value="{StaticResource Success}" />
    </Style>
    <Style x:Key="Chip.Warning" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Warning.Soft}" />
        <Setter Property="Foreground" Value="{StaticResource Warning}" />
    </Style>
    <Style x:Key="Chip.Danger" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Danger.Soft}" />
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>
    <Style x:Key="Chip.Info" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Info.Soft}" />
        <Setter Property="Foreground" Value="{StaticResource Info}" />
    </Style>

    <!-- Круглі значки: гліф або ініціали передаються через Content -->
    <Style x:Key="IconBadge" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.IconBadge}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconBadge.Large" TargetType="ContentControl" BasedOn="{StaticResource IconBadge}">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="96" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.IconLarge}" />
    </Style>

    <Style x:Key="Avatar" TargetType="ContentControl" BasedOn="{StaticResource IconBadge}">
        <Setter Property="Width" Value="{StaticResource Size.ControlSmall}" />
        <Setter Property="Height" Value="{StaticResource Size.ControlSmall}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Для ListRowCard.Selectable: на тонованому фоні вибраного рядка аватар не зливається з ним. Контекст даних має IsSelected. -->
    <Style x:Key="Avatar.Row" TargetType="ContentControl" BasedOn="{StaticResource Avatar}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Ініціали виконавця на картці дошки. -->
    <Style x:Key="Avatar.Small" TargetType="ContentControl" BasedOn="{StaticResource Avatar}">
        <Setter Property="Width" Value="{StaticResource Size.AvatarSmall}" />
        <Setter Property="Height" Value="{StaticResource Size.AvatarSmall}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Tiny}" />
    </Style>

    <!-- Крок шкали етапів: пройдений заповнений, поточний обведений, наступні сірі. Контекст даних має IsPassed та IsCurrent. -->
    <Style x:Key="StepBadge" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="{StaticResource Size.Step}" />
        <Setter Property="Height" Value="{StaticResource Size.Step}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Border}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPassed}" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Лінія між кроками шкали етапів. -->
    <Style x:Key="StepLine" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{StaticResource Border}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Розмір значка келиха задає Padding: так одна розмітка служить і меню, і вікну входу. -->
    <Style x:Key="LogoMark" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="{StaticResource Size.ControlSmall}" />
        <Setter Property="Height" Value="{StaticResource Size.ControlSmall}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{StaticResource DocCard.Gradient}" CornerRadius="{StaticResource Radius.Input}">
                        <Path Margin="{TemplateBinding Padding}"
                              Data="{StaticResource Geometry.Mug}"
                              Stretch="Uniform"
                              Stroke="{StaticResource Text.OnAccent}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.6" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LogoMark.Large" TargetType="ContentControl" BasedOn="{StaticResource LogoMark}">
        <Setter Property="Width" Value="{StaticResource Size.LogoLarge}" />
        <Setter Property="Height" Value="{StaticResource Size.LogoLarge}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Тонка смуга прокрутки для всіх ScrollViewer -->
    <Style x:Key="Scroll.ThumbStyle" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{StaticResource Scroll.Thumb}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Margin="1" Background="{TemplateBinding Background}" CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Scroll.Thumb.Hover}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{StaticResource Scroll.Thumb.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Scroll.PageButton" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Scroll.ThumbStyle}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Scroll.ThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Scroll.PageButton}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Підказка -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Text.Primary}" />
        <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Item}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Вкладки-«пігулки». Колір і насиченість задаються заголовку в шаблоні, а не самій вкладці: її властивості успадкував би вміст
      вкладки, і текст без власного кольору став би білим на білій картці. Відступ теж у шаблоні: Margin вкладки TabPanel обрізає.
    -->
    <Style TargetType="TabItem">
        <Setter Property="Height" Value="{StaticResource Size.ControlSmall}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Pill}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Margin="{StaticResource Gap.Right.8}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.PillSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          TextElement.FontSize="{StaticResource FontSize.Body}"
                                          TextElement.Foreground="{StaticResource Text.Secondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Surface.Muted}" />
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{StaticResource Text.OnAccent}" />
                            <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{StaticResource Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel Margin="{StaticResource Gap.Bottom.16}"
                                  IsItemsHost="True"
                                  KeyboardNavigation.TabIndex="1" />
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Row="1"
                                          Margin="{TemplateBinding Padding}"
                                          ContentSource="SelectedContent"
                                          KeyboardNavigation.TabIndex="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
