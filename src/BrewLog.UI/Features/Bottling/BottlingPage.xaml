<UserControl x:Class="BrewLog.UI.Features.Bottling.BottlingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Gap.Bottom.24}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Розлив" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="{StaticResource Gap.Top.4}" Text="{Binding Subtitle}" />
        </StackPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ListRowCard}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Style="{StaticResource Body.Strong}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Accent}"
                                               Text="Оформити розлив" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Number}" />
                                        <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding RecipeName}" />
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding VolumeText, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding DaysText, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding GravityText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Порожній стан -->
            <ContentControl Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource IconBadge.Large}"
                                    Margin="{StaticResource Gap.Bottom.24}"
                                    Content="{StaticResource Glyph.Search}" />
                    <TextBlock Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource Gap.Bottom.8}"
                               Text="Партій для розливу немає" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               HorizontalAlignment="Center"
                               Text="Тут з'являться партії на етапі дозрівання." />
                </StackPanel>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
