<Window x:Class="BrewLog.UI.Features.Common.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Style="{StaticResource MessageWindow}">
    <Window.Resources>
        <Style x:Key="KindBadge" TargetType="ContentControl" BasedOn="{StaticResource IconBadge}">
            <Setter Property="Background" Value="{StaticResource Info.Soft}" />
            <Setter Property="Foreground" Value="{StaticResource Info}" />
            <Setter Property="Content" Value="{StaticResource Glyph.Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource Danger.Soft}" />
                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                    <Setter Property="Content" Value="{StaticResource Glyph.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Confirm">
                    <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                    <Setter Property="Content" Value="{StaticResource Glyph.Question}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Pad.DialogShadow}">
        <StackPanel>
            <ContentControl Style="{StaticResource KindBadge}"
                            HorizontalAlignment="Left"
                            Margin="{StaticResource Gap.Bottom.16}" />
            <TextBlock Style="{StaticResource SectionTitle}"
                       Margin="{StaticResource Gap.Bottom.8}"
                       Text="{Binding Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Message}" />

            <StackPanel Margin="{StaticResource Gap.Top.24}"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}"
                        Margin="{StaticResource Gap.Right.8}"
                        Command="{Binding CancelCommand}"
                        Content="{Binding CancelText}"
                        IsCancel="{Binding HasCancel}"
                        Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConfirmCommand}"
                        Content="{Binding ConfirmText}"
                        IsCancel="{Binding IsSingleButton}"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </ContentControl>
</Window>
