<UserControl x:Class="BrewLog.UI.Features.Measurements.MeasurementsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:batchcard="clr-namespace:BrewLog.UI.Features.BatchCard">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Gap.Bottom.24}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Журнал вимірів" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="{StaticResource Gap.Top.4}" Text="{Binding Subtitle}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource Width.PreviewPane}" />
            </Grid.ColumnDefinitions>

            <!-- Активні партії: спершу ті, які сьогодні ще не міряли -->
            <DataGrid Style="{StaticResource CleanDataGrid}"
                      IsReadOnly="True"
                      RowHeight="{StaticResource Row.TwoLines}"
                      RowStyle="{StaticResource CleanDataGrid.AttentionRow}"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="*" MinWidth="{StaticResource Column.MinWide}" Header="Партія" SortMemberPath="Number">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CleanDataGrid.Caption}" Text="{Binding Number}" />
                                    <TextBlock Style="{StaticResource CleanDataGrid.Text}" FontWeight="SemiBold" Text="{Binding RecipeName}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="{StaticResource Column.Wide}" Header="Етап" SortMemberPath="StateName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <ContentControl Style="{Binding StateCode, Converter={StaticResource ResourceByKey}, ConverterParameter=Chip.}" Content="{Binding StateName}" />
                                    <TextBlock Style="{StaticResource CleanDataGrid.Caption}" Margin="{StaticResource Gap.Top.4}" Text="{Binding DaysText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="{StaticResource Column.Medium}" Header="Останній вимір">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CleanDataGrid.Text}" Text="{Binding LastValuesText}" />
                                    <TextBlock Style="{StaticResource CleanDataGrid.Caption}" Text="{Binding LastMeasuredText}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="{StaticResource Column.Attention}" Header="Увага">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Style="{StaticResource Icon}"
                                               Margin="{StaticResource Gap.Left.8}"
                                               Foreground="{Binding SeverityCode, Converter={StaticResource ResourceByKey}, ConverterParameter=Severity.}"
                                               Text="{StaticResource Glyph.Warning}"
                                               ToolTip="{Binding AlertText}"
                                               Visibility="{Binding HasAlert, Converter={StaticResource BoolToVisibility}}" />
                                    <ContentControl Style="{StaticResource Chip.Warning}"
                                                    Content="Сьогодні ще не міряли"
                                                    Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Порожній стан -->
            <ContentControl Grid.ColumnSpan="2"
                            Style="{StaticResource Card}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource IconBadge.Large}"
                                    Margin="{StaticResource Gap.Bottom.24}"
                                    Content="{StaticResource Glyph.Search}" />
                    <TextBlock Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource Gap.Bottom.8}"
                               Text="Активних партій немає" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               HorizontalAlignment="Center"
                               Text="Тут з'являться партії на етапах бродіння й дозрівання." />
                </StackPanel>
            </ContentControl>

            <!-- Вибрана партія: швидкий вимір і останні значення -->
            <ScrollViewer Grid.Column="1"
                          Margin="{StaticResource Gap.Left.24}"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedRow.Number}" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SelectedRow.RecipeName}" />
                            <batchcard:MeasurementForm DataContext="{Binding Form}" />
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap.Top.16}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="{StaticResource Gap.Bottom.8}" Text="Останні виміри" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Вимірів ще немає"
                                       Visibility="{Binding SelectedRow.HasNoRecent, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding SelectedRow.Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="{StaticResource Gap.Bottom.4}">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding DateText}" />
                                            <TextBlock DockPanel.Dock="Right"
                                                       Style="{StaticResource Body}"
                                                       Margin="{StaticResource Gap.Left.16}"
                                                       Text="{Binding TemperatureText}" />
                                            <TextBlock Style="{StaticResource Body.Strong}" HorizontalAlignment="Right" Text="{Binding GravityText}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="{StaticResource Gap.Top.16}"
                                    Command="{Binding OpenCardCommand}"
                                    Content="Відкрити картку" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
