<Window x:Class="BrewLog.UI.Features.BatchCard.ActualOgDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фактична OG"
        Style="{StaticResource MessageWindow}"
        FocusManager.FocusedElement="{Binding ElementName=OgInput}">
    <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Pad.DialogShadow}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Фактична OG" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Початкова густина після варки" />
            <TextBox x:Name="OgInput" Style="{StaticResource NumberBox}" DataContext="{Binding OgField}" />
            <StackPanel Margin="{StaticResource Gap.Top.24}"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}"
                        Margin="{StaticResource Gap.Right.8}"
                        Content="Скасувати"
                        IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConfirmCommand}"
                        Content="Зберегти"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </ContentControl>
</Window>
