<UserControl x:Class="BrewLog.UI.Features.Inventory.InventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BrewLog.UI.Controls"
             xmlns:recipes="clr-namespace:BrewLog.Domain.Recipes;assembly=BrewLog.Domain">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Gap.Right.8}">
            <!-- Шапка -->
            <DockPanel Margin="{StaticResource Gap.Bottom.24}">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="{StaticResource Gap.Right.8}"
                            Command="{Binding ExportExcelCommand}"
                            Content="Експорт в Excel" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="{StaticResource Gap.Right.8}"
                            Command="{Binding CreateOrderCommand}"
                            Content="Замовлення постачальнику"
                            Visibility="{Binding CanManageStock, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding ReceiveStockCommand}"
                            Content="Прихід сировини"
                            Visibility="{Binding CanManageStock, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Склад" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="{StaticResource Gap.Top.4}" Text="{Binding Subtitle}" />
                </StackPanel>
            </DockPanel>

            <!-- Показники -->
            <UniformGrid Margin="{StaticResource Gap.Bottom.16}" Rows="1">
                <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap.Right.8}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BigNumber}" Text="{Binding BelowMinimumCount}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Нижче мінімуму" />
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap.Right.8}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BigNumber}" Text="{Binding ExpiringCount}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Спливає ≤ 30 днів" />
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap.Right.8}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BigNumber}" Text="{Binding ExpiredCount}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Прострочено" />
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BigNumber}" Text="{Binding StockValueText}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Вартість складу, грн" />
                    </StackPanel>
                </ContentControl>
            </UniformGrid>

            <!-- Фільтри -->
            <Grid Margin="{StaticResource Gap.Bottom.16}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SegmentedGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentedButton}" Command="{Binding FilterKindCommand}" Content="Усі" IsChecked="True" />
                        <RadioButton Style="{StaticResource SegmentedButton}" Command="{Binding FilterKindCommand}" CommandParameter="{x:Static recipes:IngredientKind.Malt}" Content="Солод" />
                        <RadioButton Style="{StaticResource SegmentedButton}" Command="{Binding FilterKindCommand}" CommandParameter="{x:Static recipes:IngredientKind.Hop}" Content="Хміль" />
                        <RadioButton Style="{StaticResource SegmentedButton}" Command="{Binding FilterKindCommand}" CommandParameter="{x:Static recipes:IngredientKind.Yeast}" Content="Дріжджі" />
                        <RadioButton Style="{StaticResource SegmentedButton}" Command="{Binding FilterKindCommand}" CommandParameter="{x:Static recipes:IngredientKind.Adjunct}" Content="Додатки" />
                    </StackPanel>
                </Border>
                <TextBox Grid.Column="1"
                         Style="{StaticResource SearchBox}"
                         Margin="{StaticResource Gap.Left.16}"
                         Tag="Пошук за назвою"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Column="2"
                          Margin="{StaticResource Gap.Left.16}"
                          VerticalAlignment="Center"
                          Content="Лише нижче мінімуму"
                          IsChecked="{Binding OnlyBelowMinimum}" />
                <CheckBox Grid.Column="3"
                          Margin="{StaticResource Gap.Left.16}"
                          VerticalAlignment="Center"
                          Content="Лише зі строком ≤ 30 днів"
                          IsChecked="{Binding OnlyExpiring}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource Width.PreviewPane}" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Залишки -->
                <DataGrid Style="{StaticResource CleanDataGrid}"
                          Height="{StaticResource Height.StockTable}"
                          IsReadOnly="True"
                          ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow}"
                          Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*"
                                            MinWidth="{StaticResource Column.MinText}"
                                            Binding="{Binding Name}"
                                            ElementStyle="{StaticResource CleanDataGrid.Text}"
                                            Header="Назва" />
                        <DataGridTextColumn Width="{StaticResource Column.Number}"
                                            Binding="{Binding KindTitle}"
                                            ElementStyle="{StaticResource CleanDataGrid.Text}"
                                            Header="Тип" />
                        <DataGridTextColumn Width="{StaticResource Column.Number}"
                                            MinWidth="{StaticResource Column.MinNumber}"
                                            Binding="{Binding AvailableText}"
                                            ElementStyle="{StaticResource CleanDataGrid.Number}"
                                            Header="Доступно"
                                            HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}"
                                            SortMemberPath="Available" />
                        <DataGridTextColumn Width="{StaticResource Column.Number}"
                                            MinWidth="{StaticResource Column.MinNumber}"
                                            Binding="{Binding MinStockText}"
                                            ElementStyle="{StaticResource CleanDataGrid.Number}"
                                            Header="Мінімум"
                                            HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}"
                                            SortMemberPath="MinStock" />
                        <DataGridTextColumn Width="{StaticResource Column.Date}"
                                            Binding="{Binding NearestExpiryText}"
                                            ElementStyle="{StaticResource CleanDataGrid.Number}"
                                            Header="Строк"
                                            HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}"
                                            SortMemberPath="NearestExpiry" />
                        <DataGridTextColumn Width="{StaticResource Column.Number}"
                                            MinWidth="{StaticResource Column.MinNumber}"
                                            Binding="{Binding AveragePriceText}"
                                            ElementStyle="{StaticResource CleanDataGrid.Number}"
                                            Header="Ціна, грн"
                                            HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}"
                                            SortMemberPath="AveragePrice" />
                        <DataGridTemplateColumn Width="{StaticResource Column.Status}" Header="Статус" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{Binding StatusChip, Converter={StaticResource ResourceByKey}, ConverterParameter=Chip.}" Content="{Binding StatusText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Порожній стан -->
                <ContentControl Style="{StaticResource Card}"
                                Height="{StaticResource Height.StockTable}"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl Style="{StaticResource IconBadge.Large}"
                                        Margin="{StaticResource Gap.Bottom.24}"
                                        Content="{StaticResource Glyph.Search}" />
                        <TextBlock Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Text="Нічого не знайдено" />
                        <TextBlock Style="{StaticResource PageSubtitle}" HorizontalAlignment="Center" Text="Змініть пошук або фільтри." />
                    </StackPanel>
                </ContentControl>

                <!-- Вибрана позиція -->
                <StackPanel Grid.Column="1"
                            Grid.RowSpan="2"
                            Margin="{StaticResource Gap.Left.24}"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedRow.KindTitle}" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SelectedRow.Name}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Margin="{StaticResource Gap.Top.16}"
                                       Text="Партій із залишком немає"
                                       Visibility="{Binding SelectedRow.HasNoLots, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding SelectedRow.Lots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="{StaticResource Gap.Top.16}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Body.Strong}" Text="{Binding LeftText}" />
                                                <TextBlock Style="{StaticResource Body}" Text="{Binding ExpiryText}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding ReceivedText, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding PriceText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding SupplierText, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding CodeText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ContentControl>

                    <!-- Мінімум і ціна: лише з дозволом керувати складом -->
                    <ContentControl Style="{StaticResource Card}"
                                    Margin="{StaticResource Gap.Top.16}"
                                    Visibility="{Binding CanManageStock, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Мінімум і ціна" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="{StaticResource Gap.Right.8}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Мінімальний запас" />
                                    <TextBox Style="{StaticResource NumberBox}" DataContext="{Binding MinStockField}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Остання ціна, грн" />
                                    <TextBox Style="{StaticResource NumberBox}" DataContext="{Binding PriceField}" />
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="{StaticResource Gap.Top.16}"
                                    Command="{Binding SaveItemCommand}"
                                    Content="Зберегти" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>

                <!-- Потреба для запланованих варок -->
                <ContentControl Grid.Row="1" Style="{StaticResource Card}" Margin="{StaticResource Gap.Top.16}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="{StaticResource Gap.Bottom.8}" Text="Потреба для запланованих варок" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Запланованих варок немає"
                                   Visibility="{Binding HasNoRequirements, Converter={StaticResource BoolToVisibility}}" />
                        <DataGrid Style="{StaticResource CleanDataGrid.Flat}"
                                  controls:WheelForwarding.IsEnabled="True"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Requirements}"
                                  Visibility="{Binding HasRequirements, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*"
                                                    MinWidth="{StaticResource Column.MinText}"
                                                    Binding="{Binding Name}"
                                                    ElementStyle="{StaticResource CleanDataGrid.Text}"
                                                    Header="Позиція" />
                                <DataGridTextColumn Width="{StaticResource Column.Number}"
                                                    MinWidth="{StaticResource Column.MinNumber}"
                                                    Binding="{Binding RequiredText}"
                                                    ElementStyle="{StaticResource CleanDataGrid.Number}"
                                                    Header="Потрібно"
                                                    HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}" />
                                <DataGridTextColumn Width="{StaticResource Column.Number}"
                                                    MinWidth="{StaticResource Column.MinNumber}"
                                                    Binding="{Binding AvailableText}"
                                                    ElementStyle="{StaticResource CleanDataGrid.Number}"
                                                    Header="Є"
                                                    HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Number}"
                                                        MinWidth="{StaticResource Column.MinNumber}"
                                                        Header="Нестача"
                                                        HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource ErrorText}" HorizontalAlignment="Right" Text="{Binding ShortageText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="{StaticResource Column.Wide}"
                                                    Binding="{Binding BatchesText}"
                                                    ElementStyle="{StaticResource CleanDataGrid.Caption}"
                                                    Header="Партії" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
