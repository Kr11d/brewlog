<Window x:Class="BrewLog.UI.Features.Inventory.PurchaseOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Замовлення постачальнику"
        Style="{StaticResource MessageWindow}">
    <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Pad.DialogShadow}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Замовлення постачальнику" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Margin="{StaticResource Gap.Top.4}"
                       Text="Позиції нижче мінімуму й нестача для запланованих варок." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Постачальник" />
            <ComboBox Style="{StaticResource InputCombo}"
                      DisplayMemberPath="Title"
                      ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier}" />

            <TextBlock Style="{StaticResource Body.Strong}" Margin="{StaticResource Gap.Top.16}" Text="{Binding PreviewText}" />

            <StackPanel Margin="{StaticResource Gap.Top.24}"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}"
                        Margin="{StaticResource Gap.Right.8}"
                        Content="Скасувати"
                        IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConfirmCommand}"
                        Content="Зберегти PDF"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </ContentControl>
</Window>
