<Window x:Class="BrewLog.UI.Features.Users.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скинути пароль"
        Style="{StaticResource MessageWindow}"
        FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Pad.DialogShadow}">
        <StackPanel>
            <ContentControl Style="{StaticResource IconBadge}"
                            HorizontalAlignment="Left"
                            Margin="{StaticResource Gap.Bottom.16}"
                            Content="{StaticResource Glyph.Key}" />
            <TextBlock Style="{StaticResource SectionTitle}" Margin="{StaticResource Gap.Bottom.8}" Text="Скинути пароль" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Description}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Новий пароль" />
            <PasswordBox x:Name="PasswordInput"
                         Style="{StaticResource InputPassword}"
                         Tag="Щонайменше 6 символів"
                         PasswordChanged="OnPasswordChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Підтвердження пароля" />
            <PasswordBox x:Name="ConfirmationInput"
                         Style="{StaticResource InputPassword}"
                         Tag="Повторіть пароль"
                         PasswordChanged="OnConfirmationChanged" />

            <StackPanel Margin="{StaticResource Gap.Top.24}"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}"
                        Margin="{StaticResource Gap.Right.8}"
                        Content="Скасувати"
                        IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConfirmCommand}"
                        Content="Змінити пароль"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </ContentControl>
</Window>
