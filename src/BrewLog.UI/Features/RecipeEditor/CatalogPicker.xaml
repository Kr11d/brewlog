<UserControl x:Class="BrewLog.UI.Features.RecipeEditor.CatalogPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Вміст спливного вибору позиції довідника; контекст даних — IngredientSectionViewModel. -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClosePickerCommand}" />
        <KeyBinding Key="Return" Command="{Binding AddFirstMatchCommand}" />
    </UserControl.InputBindings>

    <!-- Прозорий край лишає місце для тіні. -->
    <Grid Width="{StaticResource Width.Picker}" Margin="{StaticResource Pad.PopupShadow}">
        <Border Background="{StaticResource Surface}"
                CornerRadius="{StaticResource Radius.Popup}"
                Effect="{StaticResource Shadow.Popup}" />
        <StackPanel Margin="{StaticResource Pad.Picker}">
            <TextBox x:Name="SearchInput"
                     Style="{StaticResource InputBox}"
                     Tag="Пошук у довіднику"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource Caption}"
                       Margin="{StaticResource Gap.Top.16}"
                       Text="Нічого не знайдено"
                       Visibility="{Binding HasNoOptions, Converter={StaticResource BoolToVisibility}}" />
            <ScrollViewer MaxHeight="{StaticResource Height.PickerList}"
                          Margin="{StaticResource Gap.Top.8}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PickerOption}" Command="{Binding AddCommand}" Content="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
