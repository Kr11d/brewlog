<Window x:Class="BrewLog.UI.Features.RecipeEditor.RecipeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BrewLog.UI.Controls"
        xmlns:editor="clr-namespace:BrewLog.UI.Features.RecipeEditor"
        Title="{Binding WindowTitle}"
        Style="{StaticResource EditorWindow}"
        FocusManager.FocusedElement="{Binding ElementName=NameInput}">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Шапка секції: заголовок, «+ Додати» зі спливним вибором і підпис для порожньої секції. Контекст даних — IngredientSectionViewModel. -->
        <DataTemplate x:Key="SectionHeader">
            <StackPanel>
                <DockPanel>
                    <Grid DockPanel.Dock="Right">
                        <Button x:Name="AddButton" Command="{Binding OpenPickerCommand}" Content="+ Додати">
                            <Button.Style>
                                <!-- Поки вибір відкритий, клік повз нього лише закриває його, а не відкриває знову через цю кнопку. -->
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton.Compact}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPickerOpen}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Popup AllowsTransparency="True"
                               IsOpen="{Binding IsPickerOpen, Mode=TwoWay}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=AddButton}"
                               PopupAnimation="Fade"
                               StaysOpen="False">
                            <editor:CatalogPicker />
                        </Popup>
                    </Grid>
                    <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Text="{Binding Title}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}"
                           Margin="{StaticResource Gap.Top.8}"
                           Text="Рядків ще немає"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RemoveLineCell">
            <Button Style="{StaticResource IconButton.Cell}"
                    Command="{Binding RemoveCommand}"
                    Content="{StaticResource Glyph.Delete}"
                    ToolTip="Видалити рядок" />
        </DataTemplate>
        <DataTemplate x:Key="AmountCell">
            <TextBox Style="{StaticResource NumberBox.Cell}" DataContext="{Binding Amount}" />
        </DataTemplate>
        <DataTemplate x:Key="YieldCell">
            <TextBox Style="{StaticResource NumberBox.Cell}" DataContext="{Binding YieldPercent}" />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="{StaticResource Pad.Dialog}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Width.EditorParams}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource Width.EditorStats}" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="{StaticResource Gap.Bottom.24}">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}"
                        Margin="{StaticResource Gap.Right.8}"
                        Command="{Binding CancelCommand}"
                        Content="Скасувати" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Content="Зберегти" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="{StaticResource Gap.Top.4}" Text="Показники оновлюються під час введення" />
            </StackPanel>
        </DockPanel>

        <!-- Ліворуч: параметри рецепта -->
        <ContentControl Grid.Row="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Параметри" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Назва" />
                    <TextBox x:Name="NameInput"
                             Style="{StaticResource InputBox}"
                             Tag="Назва рецепта"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Стиль" />
                    <ComboBox Style="{StaticResource InputCombo}"
                              DisplayMemberPath="Title"
                              ItemsSource="{Binding Styles}"
                              SelectedItem="{Binding SelectedStyle}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Обсяг партії, л" />
                    <TextBox Style="{StaticResource NumberBox}" DataContext="{Binding VolumeL}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ефективність, %" />
                    <TextBox Style="{StaticResource NumberBox}" DataContext="{Binding Efficiency}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Час кипіння, хв" />
                    <TextBox Style="{StaticResource NumberBox}" DataContext="{Binding BoilTime}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Формула IBU" />
                    <Border Style="{StaticResource SegmentedGroup}">
                        <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding Formulas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource SegmentedButton}"
                                                 Content="{Binding DisplayName}"
                                                 GroupName="IbuFormula"
                                                 IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Нотатки" />
                    <TextBox Style="{StaticResource InputArea}"
                             Tag="Особливості варки"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ScrollViewer>
        </ContentControl>

        <!-- Посередині: склад рецепта. Прокручується окремо, показники праворуч лишаються на місці. -->
        <ScrollViewer Grid.Row="1"
                      Grid.Column="1"
                      Margin="{StaticResource Gap.Left.24}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ContentControl Style="{StaticResource Card}" DataContext="{Binding Malts}">
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionHeader}" Focusable="False" IsTabStop="False" />
                        <DataGrid Style="{StaticResource CleanDataGrid.Form}"
                                  ItemsSource="{Binding Lines}"
                                  Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*"
                                                    MinWidth="{StaticResource Column.MinName}"
                                                    Binding="{Binding Name}"
                                                    ElementStyle="{StaticResource CleanDataGrid.Text}"
                                                    Header="Назва" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Input}"
                                                        CellTemplate="{StaticResource AmountCell}"
                                                        Header="кг"
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Input}"
                                                        CellTemplate="{StaticResource YieldCell}"
                                                        Header="Вихід, %"
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Input}"
                                                        Header="°L"
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource NumberBox.Cell}" DataContext="{Binding ColorLovibond}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="{StaticResource Column.Contribution}"
                                                    Binding="{Binding Contribution}"
                                                    ElementStyle="{StaticResource CleanDataGrid.Caption}"
                                                    Header="Внесок" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Icon}" CellTemplate="{StaticResource RemoveLineCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap.Top.16}" DataContext="{Binding Hops}">
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionHeader}" Focusable="False" IsTabStop="False" />
                        <DataGrid Style="{StaticResource CleanDataGrid.Form}"
                                  ItemsSource="{Binding Lines}"
                                  Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*"
                                                    MinWidth="{StaticResource Column.MinName}"
                                                    Binding="{Binding Name}"
                                                    ElementStyle="{StaticResource CleanDataGrid.Text}"
                                                    Header="Назва" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Input}"
                                                        CellTemplate="{StaticResource AmountCell}"
                                                        Header="г"
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Input}"
                                                        Header="Альфа, %"
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource NumberBox.Cell}" DataContext="{Binding AlphaPercent}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="{StaticResource Column.Input}"
                                                        Header="Хв"
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource NumberBox.Cell}" DataContext="{Binding TimeMin}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="{StaticResource Column.Medium}" Header="Використання">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource InputCombo.Cell}"
                                                      DisplayMemberPath="Title"
                                                      ItemsSource="{Binding Uses}"
                                                      SelectedItem="{Binding SelectedUse}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="{StaticResource Column.Narrow}"
                                                    Binding="{Binding Contribution}"
                                                    ElementStyle="{StaticResource CleanDataGrid.Caption}"
                                                    Header="Внесок" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Icon}" CellTemplate="{StaticResource RemoveLineCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap.Top.16}" DataContext="{Binding Yeasts}">
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionHeader}" Focusable="False" IsTabStop="False" />
                        <DataGrid Style="{StaticResource CleanDataGrid.Form}"
                                  ItemsSource="{Binding Lines}"
                                  Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*"
                                                    MinWidth="{StaticResource Column.MinName}"
                                                    Binding="{Binding Name}"
                                                    ElementStyle="{StaticResource CleanDataGrid.Text}"
                                                    Header="Назва" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Input}"
                                                        CellTemplate="{StaticResource AmountCell}"
                                                        Header="Пак."
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Wide}"
                                                        Header="Зброджування, %"
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource NumberBox.Cell}" DataContext="{Binding AttenuationPercent}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="{StaticResource Column.Input}"
                                                        Header="t° від"
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource NumberBox.Cell}" DataContext="{Binding TempMinC}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="{StaticResource Column.Input}"
                                                        Header="t° до"
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource NumberBox.Cell}" DataContext="{Binding TempMaxC}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="{StaticResource Column.Icon}" CellTemplate="{StaticResource RemoveLineCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap.Top.16}" DataContext="{Binding Adjuncts}">
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SectionHeader}" Focusable="False" IsTabStop="False" />
                        <DataGrid Style="{StaticResource CleanDataGrid.Form}"
                                  ItemsSource="{Binding Lines}"
                                  Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*"
                                                    MinWidth="{StaticResource Column.MinName}"
                                                    Binding="{Binding Name}"
                                                    ElementStyle="{StaticResource CleanDataGrid.Text}"
                                                    Header="Назва" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Input}"
                                                        CellTemplate="{StaticResource AmountCell}"
                                                        Header="кг"
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Input}"
                                                        CellTemplate="{StaticResource YieldCell}"
                                                        Header="Вихід, %"
                                                        HeaderStyle="{StaticResource CleanDataGrid.FormNumberHeader}" />
                                <DataGridTextColumn Width="{StaticResource Column.Contribution}"
                                                    Binding="{Binding Contribution}"
                                                    ElementStyle="{StaticResource CleanDataGrid.Caption}"
                                                    Header="Внесок" />
                                <DataGridTemplateColumn Width="{StaticResource Column.Icon}" CellTemplate="{StaticResource RemoveLineCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Праворуч: живі показники й відповідність стилю -->
        <ScrollViewer Grid.Row="1"
                      Grid.Column="2"
                      Margin="{StaticResource Gap.Left.24}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ContentControl Style="{StaticResource DocCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding PreviewName}" />
                        <TextBlock Style="{StaticResource Caption.OnAccent}" Margin="{StaticResource Gap.Top.4}" Text="{Binding SelectedStyle.Title}" />

                        <DockPanel Margin="{StaticResource Gap.Top.16}">
                            <Ellipse DockPanel.Dock="Right"
                                     Style="{StaticResource Swatch.Large}"
                                     Fill="{Binding Stats.Srm, Converter={StaticResource SrmToBrush}}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Stats.AbvText}" />
                                <TextBlock Style="{StaticResource Caption.OnAccent}" Text="Міцність, ABV" />
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Margin="{StaticResource Gap.Top.16}" Columns="2">
                            <StackPanel Margin="{StaticResource Gap.Bottom.8}">
                                <TextBlock Style="{StaticResource Caption.OnAccent}" Text="OG" />
                                <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding Stats.OgText}" />
                            </StackPanel>
                            <StackPanel Margin="{StaticResource Gap.Bottom.8}">
                                <TextBlock Style="{StaticResource Caption.OnAccent}" Text="FG" />
                                <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding Stats.FgText}" />
                            </StackPanel>
                            <StackPanel Margin="{StaticResource Gap.Bottom.8}">
                                <TextBlock Style="{StaticResource Caption.OnAccent}" Text="Гіркота, IBU" />
                                <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding Stats.IbuText}" />
                            </StackPanel>
                            <StackPanel Margin="{StaticResource Gap.Bottom.8}">
                                <TextBlock Style="{StaticResource Caption.OnAccent}" Text="Колір, SRM / EBC" />
                                <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding Stats.ColorText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption.OnAccent}" Text="Сировина" />
                                <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding Stats.CostText}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap.Top.16}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Відповідність стилю" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Margin="{StaticResource Gap.Top.8}"
                                   Text="Оберіть стиль, щоб побачити, чи потрапляють показники в його межі."
                                   Visibility="{Binding HasNoStyleRows, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding StyleRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="{StaticResource Gap.Top.16}">
                                        <DockPanel Margin="{StaticResource Gap.Bottom.4}">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption.StyleRange}" Text="{Binding Caption}" />
                                            <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding Parameter}" />
                                        </DockPanel>
                                        <controls:StyleRangeBar Style="{StaticResource StyleRangeBar}" Position="{Binding Position}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
