<UserControl x:Class="BrewLog.UI.Features.Recipes.RecipesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Шапка: заголовок і дії (лише з дозволом) -->
        <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Gap.Bottom.24}">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}"
                        Margin="{StaticResource Gap.Right.8}"
                        Command="{Binding OpenReferencesCommand}"
                        Content="Довідники"
                        Visibility="{Binding CanEditReferences, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource SecondaryButton}"
                        Margin="{StaticResource Gap.Right.8}"
                        Command="{Binding ImportBeerXmlCommand}"
                        Content="Імпорт BeerXML"
                        Visibility="{Binding CanEditRecipes, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource SecondaryButton}"
                        Margin="{StaticResource Gap.Right.8}"
                        Command="{Binding ExportBeerXmlCommand}"
                        Content="Експорт BeerXML"
                        IsEnabled="{Binding HasSelection}"
                        Visibility="{Binding CanEditRecipes, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewRecipeCommand}"
                        Content="Новий рецепт"
                        Visibility="{Binding CanEditRecipes, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Рецепти" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="{StaticResource Gap.Top.4}" Text="{Binding Subtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- Фільтри -->
        <Grid DockPanel.Dock="Top" Margin="{StaticResource Gap.Bottom.16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource Width.Filter}" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBox}"
                     Tag="Пошук за назвою"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1"
                      Style="{StaticResource InputCombo}"
                      Margin="{StaticResource Gap.Left.16}"
                      DisplayMemberPath="Title"
                      ItemsSource="{Binding StyleFilters}"
                      SelectedItem="{Binding SelectedStyleFilter}" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource Width.PreviewPane}" />
            </Grid.ColumnDefinitions>

            <!-- Таблиця рецептів; подвійний клік — редагувати -->
            <DataGrid Style="{StaticResource CleanDataGrid}"
                      IsReadOnly="True"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.InputBindings>
                    <MouseBinding Command="{Binding EditCommand}" Gesture="LeftDoubleClick" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*"
                                        MinWidth="{StaticResource Column.MinText}"
                                        Binding="{Binding Name}"
                                        ElementStyle="{StaticResource CleanDataGrid.Text}"
                                        Header="Назва" />
                    <DataGridTextColumn Width="*"
                                        MinWidth="{StaticResource Column.MinText}"
                                        Binding="{Binding StyleText}"
                                        ElementStyle="{StaticResource CleanDataGrid.Text}"
                                        Header="Стиль" />
                    <DataGridTextColumn Width="{StaticResource Column.Narrow}"
                                        MinWidth="{StaticResource Column.MinNarrow}"
                                        Binding="{Binding OgText}"
                                        ElementStyle="{StaticResource CleanDataGrid.Number}"
                                        Header="OG"
                                        HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}"
                                        SortMemberPath="Og" />
                    <DataGridTextColumn Width="{StaticResource Column.Narrow}"
                                        MinWidth="{StaticResource Column.MinNarrow}"
                                        Binding="{Binding FgText}"
                                        ElementStyle="{StaticResource CleanDataGrid.Number}"
                                        Header="FG"
                                        HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}"
                                        SortMemberPath="Fg" />
                    <DataGridTextColumn Width="{StaticResource Column.Narrow}"
                                        MinWidth="{StaticResource Column.MinNarrow}"
                                        Binding="{Binding AbvText}"
                                        ElementStyle="{StaticResource CleanDataGrid.Number}"
                                        Header="ABV"
                                        HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}"
                                        SortMemberPath="Abv" />
                    <DataGridTextColumn Width="{StaticResource Column.Narrow}"
                                        MinWidth="{StaticResource Column.MinNarrow}"
                                        Binding="{Binding IbuText}"
                                        ElementStyle="{StaticResource CleanDataGrid.Number}"
                                        Header="IBU"
                                        HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}"
                                        SortMemberPath="Ibu" />
                    <DataGridTemplateColumn Width="{StaticResource Column.Number}"
                                            MinWidth="{StaticResource Column.MinNumber}"
                                            Header="Колір"
                                            HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}"
                                            SortMemberPath="Srm">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Style="{StaticResource Swatch}" Fill="{Binding Srm, Converter={StaticResource SrmToBrush}}" />
                                    <TextBlock Style="{StaticResource CleanDataGrid.Number}" VerticalAlignment="Center" Text="{Binding EbcText}" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="{StaticResource Column.Number}"
                                        MinWidth="{StaticResource Column.MinNumber}"
                                        Binding="{Binding CostText}"
                                        ElementStyle="{StaticResource CleanDataGrid.Number}"
                                        Header="грн/л"
                                        HeaderStyle="{StaticResource CleanDataGrid.NumberHeader}"
                                        SortMemberPath="CostPerLiter" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Порожній стан: рецептів немає зовсім або фільтр нічого не знайшов -->
            <ContentControl Grid.ColumnSpan="2"
                            Style="{StaticResource Card}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Margin="{StaticResource Gap.Bottom.24}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource IconBadge.Large}">
                                <Setter Property="Content" Value="{StaticResource Glyph.Search}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoRecipes}" Value="True">
                                        <Setter Property="Content" Value="{StaticResource Glyph.Recipe}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <TextBlock Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource Gap.Bottom.8}"
                               Text="{Binding EmptyTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" HorizontalAlignment="Center" Text="{Binding EmptyHint}" />
                </StackPanel>
            </ContentControl>

            <!-- Прев'ю вибраного рецепта -->
            <ScrollViewer Grid.Column="1"
                          Margin="{StaticResource Gap.Left.24}"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ContentControl Style="{StaticResource DocCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding SelectedRow.Name}" />
                            <TextBlock Style="{StaticResource Caption.OnAccent}" Margin="{StaticResource Gap.Top.4}" Text="{Binding SelectedRow.StyleText}" />

                            <DockPanel Margin="{StaticResource Gap.Top.24}">
                                <Ellipse DockPanel.Dock="Right"
                                         Style="{StaticResource Swatch.Large}"
                                         Fill="{Binding SelectedRow.Srm, Converter={StaticResource SrmToBrush}}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HeroNumber}" Text="{Binding SelectedRow.AbvText}" />
                                    <TextBlock Style="{StaticResource Caption.OnAccent}" Text="Міцність, ABV" />
                                </StackPanel>
                            </DockPanel>

                            <UniformGrid Margin="{StaticResource Gap.Top.24}" Columns="2">
                                <StackPanel Margin="{StaticResource Gap.Bottom.16}">
                                    <TextBlock Style="{StaticResource Caption.OnAccent}" Text="OG → FG" />
                                    <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding SelectedRow.OgToFgText}" />
                                </StackPanel>
                                <StackPanel Margin="{StaticResource Gap.Bottom.16}">
                                    <TextBlock Style="{StaticResource Caption.OnAccent}" Text="Гіркота, IBU" />
                                    <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding SelectedRow.IbuText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption.OnAccent}" Text="Колір, EBC" />
                                    <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding SelectedRow.EbcText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption.OnAccent}" Text="Сировина" />
                                    <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding SelectedRow.CostPerLiterText}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </ContentControl>

                    <Grid Margin="{StaticResource Gap.Top.16}" Visibility="{Binding CanEditRecipes, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SecondaryButton.Compact}"
                                Margin="{StaticResource Gap.Right.4}"
                                Command="{Binding EditCommand}"
                                Content="Редагувати" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton.Compact}"
                                Margin="{StaticResource Gap.Sides.4}"
                                Command="{Binding DuplicateCommand}"
                                Content="Дублювати" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButton.Compact}"
                                Margin="{StaticResource Gap.Left.4}"
                                Command="{Binding DeleteCommand}"
                                Content="Видалити" />
                    </Grid>

                    <ContentControl Style="{StaticResource Card}" Margin="{StaticResource Gap.Top.16}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Склад" />
                            <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding SelectedRow.Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="{StaticResource Gap.Top.16}">
                                            <TextBlock Style="{StaticResource Caption}" Margin="{StaticResource Gap.Bottom.8}" Text="{Binding Title}" />
                                            <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="{StaticResource Gap.Bottom.4}">
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Style="{StaticResource Body.Strong}"
                                                                       Margin="{StaticResource Gap.Left.16}"
                                                                       Text="{Binding Amount}" />
                                                            <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="{StaticResource Gap.Top.16}"
                                        Visibility="{Binding SelectedRow.HasNotes, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <TextBlock Style="{StaticResource Caption}" Margin="{StaticResource Gap.Bottom.8}" Text="Нотатки" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding SelectedRow.Notes}" />
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
