<Application x:Class="BrewLog.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:batches="clr-namespace:BrewLog.UI.Features.Batches"
             xmlns:common="clr-namespace:BrewLog.UI.Features.Common"
             xmlns:inventory="clr-namespace:BrewLog.UI.Features.Inventory"
             xmlns:measurements="clr-namespace:BrewLog.UI.Features.Measurements"
             xmlns:recipes="clr-namespace:BrewLog.UI.Features.Recipes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel сторінки → її розмітка. Кожну нову сторінку додавайте сюди. -->
            <DataTemplate DataType="{x:Type common:PlaceholderViewModel}">
                <common:PlaceholderPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type recipes:RecipesViewModel}">
                <recipes:RecipesPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type batches:BatchesViewModel}">
                <batches:BatchesPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type measurements:MeasurementsViewModel}">
                <measurements:MeasurementsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type inventory:InventoryViewModel}">
                <inventory:InventoryPage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
