<Window x:Class="BrewLog.UI.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrewLog"
        Style="{StaticResource BrewWindow}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="{StaticResource Pad.Shell}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource Width.Menu}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ContentControl Style="{StaticResource Card}" Padding="{StaticResource Pad.Menu}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Margin="{StaticResource Gap.Bottom.24}"
                            Orientation="Horizontal">
                    <ContentControl Style="{StaticResource LogoMark}" />
                    <TextBlock Style="{StaticResource LogoText}"
                               Margin="{StaticResource Gap.Left.12}"
                               Text="BrewLog" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Divider}" Margin="{StaticResource Gap.Bottom.16}" />
                    <DockPanel Margin="{StaticResource Gap.Bottom.8}">
                        <ContentControl DockPanel.Dock="Left"
                                        Style="{StaticResource Avatar}"
                                        Content="{Binding UserName, Converter={StaticResource Initials}}" />
                        <StackPanel Margin="{StaticResource Gap.Left.12}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Body.Strong}" Text="{Binding UserName}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding UserRole}" />
                        </StackPanel>
                    </DockPanel>
                    <Button Style="{StaticResource TextButton}"
                            Command="{Binding SignOutCommand}"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}"
                                       FontSize="{StaticResource FontSize.Body}"
                                       Text="{StaticResource Glyph.SignOut}" />
                            <TextBlock Margin="{StaticResource Gap.Left.12}" Text="Вийти" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MenuButton}" Command="{Binding OpenCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" />
                                    <TextBlock Margin="{StaticResource Gap.Left.12}" Text="{Binding Title}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </ContentControl>

        <ContentControl Grid.Column="1"
                        Margin="{StaticResource Pad.Content}"
                        Content="{Binding CurrentPage}"
                        Focusable="False"
                        IsTabStop="False" />
    </Grid>
</Window>
